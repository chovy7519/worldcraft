{
  "name": "worldcraft",
  "version": "0.6.0",
  "type": "module",
  "private": true,
  "description": "An offline-first natural-language procedural 3D city builder",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "serve": "python3 -m http.server 5190",
    "serve:village": "node scripts/serve.mjs",
    "inspect": "node scripts/inspect.mjs",
    "verify": "npm test && npm run build && npm run inspect"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {}
}
